{
  "model_name": "Qwen/Qwen2.5-7B-Instruct",
  "hook_name": "blocks.14.hook_resid_post",
  "dtype": "float32",

  "positive_dataset_path": "TQRG/DeltaSecommits_qwen-2.5-7b-instruct_tokenized",
  "negative_dataset_path": "TQRG/DeltaSecommits_vulnerable_qwen-2.5-7b-instruct_tokenized",
  "input_ids_column": "input_ids",
  "streaming": true,
  "max_seq_len": 512,

  "batch_size": 32,
  "lr": 3e-4,
  "training_steps": 10000,
  "warmup_steps": 500,
  "log_every": 50,
  "save_every": 1000,

  "wandb_project": "Contrastive-SAE",
  "checkpoint_dir": "checkpoints/contrastive_sae",

  "sae": {
    "d_in": 3584,
    "d_sae": 16384,
    "k": 64,
    "contrastive_weight": 0.1,
    "contrastive_temperature": 0.07,
    "contrastive_mode": "infonce",
    "use_feature_contrastive": true
  }
}
