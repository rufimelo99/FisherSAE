  "sae_lens_version": "latest",
  "sae_lens_training_version": "latest",
  "exclude_special_tokens": false,

  "sae": {
    "d_in": 3584,
    "d_sae": 28672,
    "dtype": "float32",
    "device": "cpu",
    "apply_b_dec_to_input": true,
    "normalize_activations": "layer_norm",
    "reshape_activations": "none",
    "type": "topk",
    "k": 64,
    "rescale_acts_by_decoder_norm": true
